# ===== Configuração do TCC+ (copie para .env e ajuste) =====
PORT=3000
APP_URL=http://localhost:3000

# Banco de dados MySQL (o mesmo do MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tcc_afya

# Chave usada para assinar a sessão. Troque por um texto longo e secreto.
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio-com-32-caracteres

# E-mail (opcional). Sem SMTP_HOST, os e-mails aparecem apenas no console do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TCC+ Afya Ji-Paraná <nao-responda@afya.teste>